<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Halo entitlements。

  关键：不包含 com.apple.security.app-sandbox。
  App Sandbox 下的应用无法响应 Finder 任意目录的 NSServices（既拿不到选中
  目录的写权限，Services 也会被系统限制），因此 Finder 右键菜单功能必须
  关闭沙盒；hardened runtime 保留（见 tauri.conf.json 的
  bundle.macOS.hardenedRuntime）。

  仅声明自动化（Apple Events）权限：「在终端中打开」服务需要通过 osascript
  控制 Terminal（com.apple.security.automation.apple-events）。
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
