{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipBase",
  "version": "0.1.0",
  "identifier": "com.clipbase.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipBase",
        "width": 900,
        "height": 640,
        "minWidth": 420,
        "minHeight": 360,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 20 },
        "transparent": true,
        "shadow": true,
        "backgroundColor": "#00000000",
        "center": true,
        "visible": false,
        "visibleOnAllWorkspaces": false
      },
      {
        "label": "panel",
        "title": "ClipBase 面板",
        "width": 900,
        "height": 220,
        "minWidth": 320,
        "minHeight": 220,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "backgroundColor": "#00000000",
        "center": true,
        "visible": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "ring",
        "title": "ClipBase 环形转换",
        "width": 342,
        "height": 342,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "backgroundColor": "#00000000",
        "center": true,
        "visible": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.clipbase/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "An open-source, extensible clipboard manager",
    "longDescription": "ClipBase is an open-source, extensible clipboard manager for macOS.",
    "macOS": {
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "files": {
        "PlugIns/ClipBaseFinderExtension.appex": "finder-extension/build/ClipBaseFinderExtension.appex"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
