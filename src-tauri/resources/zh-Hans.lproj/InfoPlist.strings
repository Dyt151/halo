/*
 * 让 TIS 返回中文输入法名。
 *
 * `kTISPropertyLocalizedName` 按 App 自身支持的本地化来选语言：bundle 里没有
 * zh-Hans.lproj 时，即使系统是中文，「简体拼音」也会读成 "Pinyin – Simplified"。
 * 只放这个文件就够——正版同样只有 InfoPlist.strings（文案逐字照抄正版
 * Resources/zh-Hans.lproj/InfoPlist.strings，Apache-2.0，见 NOTICE-STATUS-TRIO.txt）。
 */
"NSLocationUsageDescription" = "用于在弹出窗口中显示当前 Wi-Fi 名称，并在打开 Wi-Fi 详情时读取网络名称、扫描结果和连接信息。";
"NSLocationWhenInUseUsageDescription" = "用于在弹出窗口中显示当前 Wi-Fi 名称，并在打开 Wi-Fi 详情时读取网络名称、扫描结果和连接信息。";
"NSBluetoothAlwaysUsageDescription" = "用于显示蓝牙连接状态，为附近有名称的设备及此 Mac 已信任的设备读取电量/型号信息，并在支持的耳机上切换降噪模式；附近读取仅使用你明确授权的 BLE UUID。";
