classDiagram
    class ClipItem {
        +i64 id
        +ContentType content_type
        +ClipContent content
        +String preview
        +Option~String~ source_app
        +i64 created_at
        +i64 last_used_at
        +bool pinned
        +bool favorite
        +bool sensitive
        +u64 size_bytes
        +String hash
        +SyncState sync_state
    }
    class ContentType {
        <<enumeration>>
        Text
        Html
        Image
        Files
        Unknown
    }
    class ClipContent {
        <<enumeration>>
        Text(String)
        Html(String)
        Image(path, width, height)
        Files(Vec~String~)
    }
    class Config {
        +u32 max_items
        +u64 max_bytes
        +bool monitor_enabled
        +u64 poll_interval_ms
        +SensitivityPolicy sensitivity
        +HotkeyConfig hotkeys
        +SyncConfig sync
    }
    class SyncConfig {
        +bool enabled
        +SyncProviderKind provider
        +SyncCredentials credentials
        +bool encryption
    }
    class ClipboardPort {
        <<interface>>
        +read() Result~ClipContent~
        +write(content) Result
        +change_count() Result~u64~
        +frontmost_app() Option~String~
    }
    class ClipboardMonitor {
        -i64 last_change_count
        +start(tx) Result
        +stop() Result
        +poll_once() Result~Option~ClipContent~~
    }
    class HistoryService {
        +insert(ClipItem) Result~i64~
        +query(HistoryQuery) Result~Vec~ClipItem~~
        +get(id) Result~ClipItem~
        +delete(id) Result
        +clear() Result
        +pin(id, bool) Result
    }
    class HotkeyManager {
        +register(HotkeyConfig) Result
        +unregister() Result
        +set(hotkey, action) Result
    }
    class PasteService {
        +paste(id) Result~PasteOutcome~
        +write_to_clipboard(content) Result
        +trigger_paste() Result
    }
    class SensitivityDetector {
        +detect(content) SensitivityResult
    }
    class SyncProvider {
        <<interface>>
        +kind() SyncProviderKind
        +test(creds) Result
        +push(snapshot) Result
        +pull(since) Result~SyncSnapshot~
    }
    class WebDavProvider {
        +client reqwest::Client
    }
    class SyncManager {
        +set_provider(provider) Result
        +sync_now() Result
        +start() Result
        +stop() Result
    }
    class ModuleHost {
        +discover() Result~Vec~ModuleManifest~~
        +install(path) Result~ModuleManifest~
        +uninstall(id) Result
        +enable(id, grants) Result
        +disable(id) Result
        +list() Result~Vec~ModuleRecord~~
        +invoke(id, msg) Result~ModuleMessage~
    }
    class ModuleManifest {
        +u32 schema
        +ModuleId id
        +String name
        +String version
        +String min_core
        +ModuleRuntime runtime
        +Vec~Capability~ permissions
        +Vec~Contribution~ contributions
        +Lifecycle lifecycle
    }
    class ModuleInstance {
        +ModuleId id
        +ModuleState state
        +InstanceHandle handle
        +Vec~Capability~ grants
        +start(ctx) Result
        +stop() Result
        +send(msg) Result
    }
    class Capability {
        <<enumeration>>
        ClipboardRead
        ClipboardWrite
        FsReadModule
        FsReadUser
        FsWriteUser
        Network
    }
    class Contribution {
        <<enumeration>>
        Tray
        ClipboardAction
        Shortcut
        Settings
        Command
    }
    class CapabilityGate {
        +check(id, capability, payload) Result~bool~
        +grant(id, caps) Result
        +revoke(id) Result
    }
    class MessageBus {
        +subscribe(topic, handler)
        +publish(topic, payload)
        +unsubscribe(topic, handler)
    }
    class AppState {
        +ClipboardMonitor monitor
        +HistoryService history
        +HotkeyManager hotkey
        +PasteService paste
        +ModuleHost modules
        +SyncManager sync
        +ConfigService config
    }

    AppState *-- ClipboardMonitor
    AppState *-- HistoryService
    AppState *-- HotkeyManager
    AppState *-- PasteService
    AppState *-- ModuleHost
    AppState *-- SyncManager
    HistoryService --> ClipItem
    ClipboardMonitor --> ClipContent
    ClipboardMonitor --> ClipboardPort
    SyncManager --> SyncProvider
    WebDavProvider ..|> SyncProvider
    ModuleHost --> ModuleInstance
    ModuleHost --> CapabilityGate
    ModuleHost --> MessageBus
    ModuleInstance --> ModuleManifest
    ModuleManifest --> Capability
    ModuleManifest --> Contribution
    Config --> SyncConfig
