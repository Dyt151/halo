{
  "schema": 1,
  "id": "com.clipbase.filee",
  "name": "文件转换",
  "version": "0.1.0",
  "min_core": "0.1.0",
  "description": "基于 filee 的本地文件转换工具示例模块",
  "author": "clipbase-community",
  "runtime": "sidecar",
  "entry": {
    "backend": "bin/filee-cli",
    "ui": "index.html"
  },
  "permissions": [
    "clipboard:read",
    "clipboard:write"
  ],
  "contributions": [
    { "type": "tray", "label": "文件转换", "icon": "icon.png" },
    { "type": "clipboard_action", "label": "转换此文件", "mime": ["image/*", "application/pdf"] },
    { "type": "shortcut", "label": "打开文件转换", "default": "Cmd+Shift+F" },
    { "type": "settings", "label": "文件转换设置" }
  ],
  "lifecycle": { "run_on": "demand" }
}
