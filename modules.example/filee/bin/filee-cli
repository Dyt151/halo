#!/bin/sh
# 最小 JSON-RPC 2.0 over stdio 示例 sidecar。
# 读取 stdin 每行一个 JSON 请求，回显一条 result 响应。
# 仅作演示：真实模块可替换为任意语言实现的可执行文件。

while IFS= read -r line; do
  [ -z "$line" ] && continue
  # 提取请求 id（简单正则，满足演示即可）。
  id=$(printf '%s' "$line" | sed -n 's/.*"id"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
  method=$(printf '%s' "$line" | sed -n 's/.*"method"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  echo "{\"jsonrpc\":\"2.0\",\"id\":$id,\"result\":{\"ok\":true,\"module\":\"com.halo.filee\",\"method\":\"$method\",\"message\":\"filee-cli 已收到请求（示例响应）\"}}"
done
