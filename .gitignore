# --- 依赖 ---
node_modules/

# --- 构建产物 ---
dist/
release/
src-tauri/target/
# Finder Sync 扩展的编译产物：.appex 是签名过的二进制包，不进版本库
# （HEAD 里曾提交过陈旧的 ClipBaseFinderExtension.appex，每次构建又多一份 diff）
src-tauri/finder-extension/build/

# --- 系统文件 ---
.DS_Store
.AppleDouble
.LSOverride
# 注意：不要用 `Icon?` 忽略 macOS Finder 自定义图标文件——在大小写不敏感的
# macOS 上 `Icon?` 会误匹配 `icons/` 目录，把 src-tauri/icons 整个排除掉，
# 导致 tauri::generate_context!() 在编译/CI 时找不到 bundle.icon 引用的图标。
._*

# --- 日志 ---
*.log

# --- 编辑器 / IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- WorkBuddy 本地工作数据 ---
.workbuddy/
